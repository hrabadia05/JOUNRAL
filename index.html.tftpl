<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Ledgerline — Trading Journal &amp; Desk Chat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/amazon-cognito-identity-js@6.3.12/dist/amazon-cognito-identity.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  :root{
    --bg: #0a0c0f;
    --panel: #12151a;
    --panel-raised: #171b21;
    --border: #232830;
    --text: #e7e9ec;
    --text-dim: #8a919c;
    --text-faint: #565d68;
    --amber: #f2a93b;
    --amber-dim: #8a6423;
    --long: #3ecf8e;
    --short: #ef5b5b;
    --font-display: 'IBM Plex Mono', monospace;
    --font-body: 'Inter', sans-serif;
    --radius: 3px;
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    min-height:100vh;
    -webkit-font-smoothing: antialiased;
  }
  ::selection{ background: var(--amber-dim); color:#fff; }
  a{ color: var(--amber); }
  ::-webkit-scrollbar{ width:9px; height:9px; }
  ::-webkit-scrollbar-track{ background: var(--bg); }
  ::-webkit-scrollbar-thumb{ background: var(--border); border-radius: 6px; }

  button{ font-family: var(--font-body); cursor:pointer; }
  input, textarea, select{ font-family: var(--font-body); }

  .hidden{ display:none !important; }

  /* ---------- Auth screens ---------- */
  #auth-screen{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:
      radial-gradient(circle at 20% 10%, rgba(242,169,59,0.05), transparent 40%),
      var(--bg);
  }
  .auth-card{
    width:100%;
    max-width:400px;
    background: var(--panel);
    border:1px solid var(--border);
    border-radius: 6px;
    padding:36px 32px;
  }
  .auth-brand{
    font-family: var(--font-display);
    font-size:13px;
    letter-spacing:0.18em;
    color: var(--amber);
    text-transform:uppercase;
    margin-bottom:6px;
  }
  .auth-title{
    font-size:22px;
    font-weight:600;
    margin:0 0 24px 0;
  }
  .field{ margin-bottom:16px; }
  .field label{
    display:block;
    font-size:12px;
    color: var(--text-dim);
    margin-bottom:6px;
    letter-spacing:0.02em;
  }
  .field input{
    width:100%;
    background: var(--panel-raised);
    border:1px solid var(--border);
    color: var(--text);
    padding:10px 12px;
    border-radius: var(--radius);
    font-size:14px;
    outline:none;
    transition: border-color .15s;
  }
  .field input:focus{ border-color: var(--amber); }
  .btn-primary{
    width:100%;
    background: var(--amber);
    color:#1a1200;
    font-weight:600;
    border:none;
    padding:11px;
    border-radius: var(--radius);
    font-size:14px;
    transition: filter .15s;
  }
  .btn-primary:hover{ filter:brightness(1.08); }
  .btn-primary:disabled{ opacity:0.5; cursor:not-allowed; }
  .btn-link{
    background:none;
    border:none;
    color: var(--text-dim);
    font-size:13px;
    padding:0;
    text-decoration:underline;
    text-underline-offset:3px;
  }
  .btn-link:hover{ color: var(--amber); }
  .auth-switch{ margin-top:18px; text-align:center; font-size:13px; color:var(--text-dim); }
  .auth-error{
    background: rgba(239,91,91,0.1);
    border:1px solid rgba(239,91,91,0.3);
    color: var(--short);
    font-size:13px;
    padding:10px 12px;
    border-radius: var(--radius);
    margin-bottom:16px;
  }
  .auth-note{ font-size:12px; color: var(--text-faint); margin-bottom:16px; line-height:1.5; }

  /* ---------- App shell ---------- */
  #app-screen{ display:none; min-height:100vh; grid-template-rows:auto 1fr; }
  header.topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 24px;
    border-bottom:1px solid var(--border);
    background: var(--panel);
  }
  .topbar-left{ display:flex; align-items:center; gap:10px; }
  .logo-mark{
    width:26px; height:26px;
    border:1.5px solid var(--amber);
    border-radius:4px;
    display:flex; align-items:center; justify-content:center;
    font-family: var(--font-display);
    color: var(--amber);
    font-weight:700;
    font-size:13px;
  }
  .topbar-title{ font-family: var(--font-display); font-size:15px; letter-spacing:0.06em; }
  .topbar-title span{ color: var(--text-faint); }
  .topbar-right{ display:flex; align-items:center; gap:16px; }
  .user-chip{
    font-size:13px; color:var(--text-dim);
    display:flex; align-items:center; gap:8px;
  }
  .avatar-dot{
    width:26px; height:26px; border-radius:50%;
    background: var(--panel-raised);
    border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    font-size:11px; font-weight:600; color:var(--amber);
  }
  .btn-ghost{
    background:none; border:1px solid var(--border);
    color: var(--text-dim);
    padding:7px 14px; border-radius: var(--radius);
    font-size:13px;
    transition: all .15s;
  }
  .btn-ghost:hover{ border-color: var(--short); color: var(--short); }

  .layout{
    display:grid;
    grid-template-columns: 1fr 360px;
    gap:0;
    min-height: calc(100vh - 57px);
  }
  @media (max-width: 940px){
    .layout{ grid-template-columns: 1fr; }
  }

  main.workspace{ padding:28px 32px; overflow-y:auto; }
  .section-label{
    font-family: var(--font-display);
    font-size:11px;
    letter-spacing:0.14em;
    color: var(--text-faint);
    text-transform:uppercase;
    margin-bottom:14px;
    display:flex; align-items:center; gap:10px;
  }
  .section-label::after{
    content:''; flex:1; height:1px; background: var(--border);
  }

  /* ---------- Journal form ---------- */
  .journal-form{
    background: var(--panel);
    border:1px solid var(--border);
    border-radius:6px;
    padding:22px;
    margin-bottom:36px;
  }
  .form-grid{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap:14px;
    margin-bottom:14px;
  }
  @media (max-width: 640px){ .form-grid{ grid-template-columns: 1fr 1fr; } }
  .form-grid .field{ margin-bottom:0; }
  select{
    width:100%;
    background: var(--panel-raised);
    border:1px solid var(--border);
    color: var(--text);
    padding:10px 12px;
    border-radius: var(--radius);
    font-size:14px;
    outline:none;
  }
  textarea{
    width:100%;
    background: var(--panel-raised);
    border:1px solid var(--border);
    color: var(--text);
    padding:10px 12px;
    border-radius: var(--radius);
    font-size:14px;
    min-height:90px;
    resize:vertical;
    outline:none;
  }
  textarea:focus, select:focus{ border-color: var(--amber); }

  .dropzone{
    border:1.5px dashed var(--border);
    border-radius: var(--radius);
    padding:20px;
    text-align:center;
    color: var(--text-faint);
    font-size:13px;
    cursor:pointer;
    transition: border-color .15s, background .15s;
    margin-bottom:14px;
  }
  .dropzone.dragover{ border-color: var(--amber); background: rgba(242,169,59,0.05); }
  .dropzone img{ max-width:100%; max-height:180px; border-radius: var(--radius); }

  .form-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:6px; }
  .btn-primary.small{ width:auto; padding:10px 22px; }

  /* ---------- Journal history ---------- */
  .entry-card{
    background: var(--panel);
    border:1px solid var(--border);
    border-radius:6px;
    margin-bottom:12px;
    overflow:hidden;
  }
  .entry-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 18px;
    cursor:pointer;
  }
  .entry-head:hover{ background: var(--panel-raised); }
  .entry-meta{ display:flex; align-items:center; gap:12px; font-size:13px; }
  .instrument-tag{
    font-family: var(--font-display);
    font-size:12px; font-weight:700;
    padding:3px 8px; border-radius:3px;
    background: var(--panel-raised);
    border:1px solid var(--border);
  }
  .dir-tag{ font-size:11px; font-weight:700; padding:3px 8px; border-radius:3px; letter-spacing:0.04em; }
  .dir-tag.long{ color: var(--long); background: rgba(62,207,142,0.12); }
  .dir-tag.short{ color: var(--short); background: rgba(239,91,91,0.12); }
  .entry-date{ color: var(--text-dim); font-family: var(--font-display); font-size:12px; }
  .entry-body{ padding:0 18px 18px 18px; display:none; border-top:1px solid var(--border); }
  .entry-body.open{ display:block; }
  .entry-notes{ font-size:14px; color: var(--text-dim); margin:14px 0; line-height:1.6; }
  .entry-chart img{ max-width:100%; border-radius: var(--radius); border:1px solid var(--border); margin-bottom:14px; }
  .ai-block{
    background: var(--panel-raised);
    border:1px solid var(--border);
    border-radius: var(--radius);
    padding:14px 16px;
  }
  .ai-source{ font-family: var(--font-display); font-size:10px; color: var(--text-faint); letter-spacing:0.1em; text-transform:uppercase; margin-bottom:8px; }
  .ai-summary{ font-size:13px; margin-bottom:10px; }
  .ai-cols{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .ai-cols h4{ font-size:11px; color: var(--text-faint); margin:0 0 6px 0; text-transform:uppercase; letter-spacing:0.06em; }
  .ai-cols ul{ margin:0; padding-left:16px; font-size:13px; color: var(--text-dim); }
  .empty-state{ color: var(--text-faint); font-size:13px; padding:20px; text-align:center; }

  /* ---------- Chat sidebar ---------- */
  aside.chat-panel{
    background: var(--panel);
    border-left:1px solid var(--border);
    display:flex; flex-direction:column;
    height: calc(100vh - 57px);
    position:sticky; top:57px;
  }
  .chat-header{
    padding:16px 18px;
    border-bottom:1px solid var(--border);
    display:flex; align-items:center; justify-content:space-between;
  }
  .chat-title{ font-family: var(--font-display); font-size:13px; letter-spacing:0.06em; }
  .status-indicator{ display:flex; align-items:center; gap:6px; font-size:11px; color: var(--text-dim); }
  .status-dot{ width:7px; height:7px; border-radius:50%; background: var(--short); transition: background .2s; }
  .status-dot.connected{ background: var(--long); box-shadow: 0 0 6px rgba(62,207,142,0.6); }

  .chat-feed{ flex:1; overflow-y:auto; padding:14px 18px; display:flex; flex-direction:column; gap:14px; }
  .chat-msg{ font-size:13px; }
  .chat-msg-head{ display:flex; align-items:baseline; gap:8px; margin-bottom:2px; }
  .chat-handle{ font-weight:600; color: var(--amber); font-size:12px; }
  .chat-time{ font-size:10px; color: var(--text-faint); font-family: var(--font-display); }
  .chat-text{ color: var(--text); line-height:1.5; word-break:break-word; }
  .chat-msg.own .chat-handle{ color: var(--long); }

  .chat-input-row{
    display:flex; gap:8px;
    padding:14px 18px;
    border-top:1px solid var(--border);
  }
  .chat-input-row input{
    flex:1;
    background: var(--panel-raised);
    border:1px solid var(--border);
    color: var(--text);
    padding:9px 12px;
    border-radius: var(--radius);
    font-size:13px;
    outline:none;
  }
  .chat-input-row input:focus{ border-color: var(--amber); }
  .btn-send{
    background: var(--amber); color:#1a1200; border:none;
    padding:9px 16px; border-radius: var(--radius); font-weight:600; font-size:13px;
  }
  .btn-send:disabled{ opacity:0.4; cursor:not-allowed; }
</style>
</head>
<body>

<!-- ============ CONFIG BANNER (shown until config filled in) ============ -->
<div id="config-warning" class="hidden" style="background:#3a1f0a;color:#f2a93b;padding:10px 20px;font-size:13px;font-family:'IBM Plex Mono',monospace;text-align:center;">
  ⚠ Fill in the CONFIG object at the top of the &lt;script&gt; tag with your Terraform outputs before using this app.
</div>

<!-- ============ AUTH SCREEN ============ -->
<div id="auth-screen">
  <div class="auth-card">
    <div class="auth-brand">Ledgerline</div>

    <!-- LOGIN VIEW -->
    <div id="view-login">
      <h1 class="auth-title">Sign in</h1>
      <div id="login-error" class="auth-error hidden"></div>
      <div class="field"><label>Email</label><input type="email" id="login-email" autocomplete="username"/></div>
      <div class="field"><label>Password</label><input type="password" id="login-password" autocomplete="current-password"/></div>
      <button class="btn-primary" id="btn-login">Sign in</button>
      <div class="auth-switch">
        <button class="btn-link" data-goto="signup">Create an account</button> ·
        <button class="btn-link" data-goto="forgot">Forgot password?</button>
      </div>
    </div>

    <!-- SIGNUP VIEW -->
    <div id="view-signup" class="hidden">
      <h1 class="auth-title">Create account</h1>
      <div id="signup-error" class="auth-error hidden"></div>
      <div class="field"><label>Email</label><input type="email" id="signup-email" autocomplete="username"/></div>
      <div class="field"><label>Password</label><input type="password" id="signup-password" autocomplete="new-password"/></div>
      <div class="auth-note">Min 8 characters, one uppercase letter, one lowercase letter, one number.</div>
      <button class="btn-primary" id="btn-signup">Sign up</button>
      <div class="auth-switch"><button class="btn-link" data-goto="login">Back to sign in</button></div>
    </div>

    <!-- CONFIRM SIGNUP VIEW -->
    <div id="view-confirm" class="hidden">
      <h1 class="auth-title">Verify email</h1>
      <div id="confirm-error" class="auth-error hidden"></div>
      <div class="auth-note">Enter the 6-digit code we emailed you.</div>
      <div class="field"><label>Verification code</label><input type="text" id="confirm-code" inputmode="numeric"/></div>
      <button class="btn-primary" id="btn-confirm">Verify &amp; continue</button>
      <div class="auth-switch"><button class="btn-link" data-goto="login">Back to sign in</button></div>
    </div>

    <!-- FORGOT PASSWORD STEP 1 -->
    <div id="view-forgot" class="hidden">
      <h1 class="auth-title">Reset password</h1>
      <div id="forgot-error" class="auth-error hidden"></div>
      <div class="auth-note">We'll email you a reset code.</div>
      <div class="field"><label>Email</label><input type="email" id="forgot-email" autocomplete="username"/></div>
      <button class="btn-primary" id="btn-forgot-send">Send reset code</button>
      <div class="auth-switch"><button class="btn-link" data-goto="login">Back to sign in</button></div>
    </div>

    <!-- FORGOT PASSWORD STEP 2 -->
    <div id="view-forgot-confirm" class="hidden">
      <h1 class="auth-title">Set new password</h1>
      <div id="forgot-confirm-error" class="auth-error hidden"></div>
      <div class="field"><label>Reset code</label><input type="text" id="forgot-code" inputmode="numeric"/></div>
      <div class="field"><label>New password</label><input type="password" id="forgot-new-password" autocomplete="new-password"/></div>
      <button class="btn-primary" id="btn-forgot-confirm">Update password</button>
      <div class="auth-switch"><button class="btn-link" data-goto="login">Back to sign in</button></div>
    </div>
  </div>
</div>

<!-- ============ MAIN APP SCREEN ============ -->
<div id="app-screen">
  <header class="topbar">
    <div class="topbar-left">
      <div class="logo-mark">L</div>
      <div class="topbar-title">LEDGERLINE <span>/ desk journal</span></div>
    </div>
    <div class="topbar-right">
      <div class="user-chip">
        <div class="avatar-dot" id="user-initial">?</div>
        <span id="user-email">—</span>
      </div>
      <button class="btn-ghost" id="btn-logout">Log out</button>
    </div>
  </header>

  <div class="layout">
    <main class="workspace">
      <div class="section-label">New entry</div>
      <form class="journal-form" id="journal-form">
        <div class="form-grid">
          <div class="field">
            <label>Date</label>
            <input type="date" id="entry-date" required />
          </div>
          <div class="field">
            <label>Instrument</label>
            <select id="entry-instrument" required>
              <option value="">Select…</option>
              <option value="ES">ES</option>
              <option value="NQ">NQ</option>
              <option value="MES">MES</option>
              <option value="MNQ">MNQ</option>
            </select>
          </div>
          <div class="field">
            <label>Direction</label>
            <select id="entry-direction" required>
              <option value="Long">Long</option>
              <option value="Short">Short</option>
            </select>
          </div>
          <div class="field">
            <label>Entry / Exit</label>
            <div style="display:flex; gap:6px;">
              <input type="number" step="0.01" id="entry-price" placeholder="Entry" style="background:var(--panel-raised);border:1px solid var(--border);color:var(--text);padding:10px 8px;border-radius:3px;width:50%;outline:none;"/>
              <input type="number" step="0.01" id="exit-price" placeholder="Exit" style="background:var(--panel-raised);border:1px solid var(--border);color:var(--text);padding:10px 8px;border-radius:3px;width:50%;outline:none;"/>
            </div>
          </div>
        </div>

        <div class="dropzone" id="dropzone">
          <div id="dropzone-placeholder">Drop a chart screenshot here, or click to upload</div>
          <img id="dropzone-preview" class="hidden" />
          <input type="file" id="file-input" accept="image/*" class="hidden" />
        </div>

        <div class="field">
          <label>Trade rationale / notes</label>
          <textarea id="entry-notes" placeholder="What was the setup? What went right or wrong?"></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary small" id="btn-save">Save &amp; Analyze</button>
        </div>
      </form>

      <div class="section-label">Journal history</div>
      <div id="journal-feed">
        <div class="empty-state">No entries yet. Log your first trade above.</div>
      </div>
    </main>

    <aside class="chat-panel">
      <div class="chat-header">
        <div class="chat-title">DESK CHAT</div>
        <div class="status-indicator">
          <div class="status-dot" id="ws-status-dot"></div>
          <span id="ws-status-text">Disconnected</span>
        </div>
      </div>
      <div class="chat-feed" id="chat-feed">
        <div class="empty-state">Connecting to the trading desk…</div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chat-input" placeholder="Message the desk…" maxlength="2000" disabled />
        <button class="btn-send" id="btn-send-chat" disabled>Send</button>
      </div>
    </aside>
  </div>
</div>

<script>
/* =========================================================================
   CONFIG — fill these in with your `terraform output` values after `apply`
   ========================================================================= */
const CONFIG = {
  AWS_REGION:            "${aws_region}",
  COGNITO_USER_POOL_ID:  "${cognito_user_pool_id}",
  COGNITO_CLIENT_ID:     "${cognito_client_id}",
  HTTP_API_URL:          "${http_api_url}",
  WEBSOCKET_API_URL:     "${websocket_api_url}"
};

if (CONFIG.COGNITO_USER_POOL_ID.includes("XXXX")) {
  document.getElementById("config-warning").classList.remove("hidden");
}

/* =========================================================================
   Cognito setup
   ========================================================================= */
const poolData = {
  UserPoolId: CONFIG.COGNITO_USER_POOL_ID,
  ClientId: CONFIG.COGNITO_CLIENT_ID,
};
const userPool = new AmazonCognitoIdentity.CognitoUserPool(poolData);

let currentCognitoUser = null;
let pendingForgotEmail = null;
let session = { idToken: null, accessToken: null, email: null };

function showAuthError(viewId, message) {
  const el = document.getElementById(viewId);
  el.textContent = message;
  el.classList.remove("hidden");
}
function clearAuthErrors() {
  document.querySelectorAll(".auth-error").forEach((el) => el.classList.add("hidden"));
}

document.querySelectorAll("[data-goto]").forEach((btn) => {
  btn.addEventListener("click", () => switchAuthView(btn.dataset.goto));
});
function switchAuthView(name) {
  clearAuthErrors();
  ["login", "signup", "confirm", "forgot", "forgot-confirm"].forEach((v) => {
    document.getElementById("view-" + v).classList.toggle("hidden", v !== name);
  });
}

/* ---- Login ---- */
document.getElementById("btn-login").addEventListener("click", () => {
  clearAuthErrors();
  const email = document.getElementById("login-email").value.trim();
  const password = document.getElementById("login-password").value;
  if (!email || !password) return showAuthError("login-error", "Email and password are required.");

  const authDetails = new AmazonCognitoIdentity.AuthenticationDetails({ Username: email, Password: password });
  const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: email, Pool: userPool });
  currentCognitoUser = cognitoUser;

  cognitoUser.authenticateUser(authDetails, {
    onSuccess: (result) => {
      session.idToken = result.getIdToken().getJwtToken();
      session.accessToken = result.getAccessToken().getJwtToken();
      session.email = email;
      enterApp();
    },
    onFailure: (err) => showAuthError("login-error", err.message || "Login failed."),
  });
});

/* ---- Signup ---- */
document.getElementById("btn-signup").addEventListener("click", () => {
  clearAuthErrors();
  const email = document.getElementById("signup-email").value.trim();
  const password = document.getElementById("signup-password").value;
  if (!email || !password) return showAuthError("signup-error", "Email and password are required.");

  const attributeList = [new AmazonCognitoIdentity.CognitoUserAttribute({ Name: "email", Value: email })];

  userPool.signUp(email, password, attributeList, null, (err, result) => {
    if (err) return showAuthError("signup-error", err.message || "Sign up failed.");
    currentCognitoUser = result.user;
    switchAuthView("confirm");
  });
});

/* ---- Confirm signup ---- */
document.getElementById("btn-confirm").addEventListener("click", () => {
  clearAuthErrors();
  const code = document.getElementById("confirm-code").value.trim();
  if (!currentCognitoUser) return showAuthError("confirm-error", "Session expired, please sign up again.");
  currentCognitoUser.confirmRegistration(code, true, (err) => {
    if (err) return showAuthError("confirm-error", err.message || "Verification failed.");
    switchAuthView("login");
  });
});

/* ---- Forgot password step 1 ---- */
document.getElementById("btn-forgot-send").addEventListener("click", () => {
  clearAuthErrors();
  const email = document.getElementById("forgot-email").value.trim();
  if (!email) return showAuthError("forgot-error", "Enter your email.");
  pendingForgotEmail = email;
  const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: email, Pool: userPool });
  cognitoUser.forgotPassword({
    onSuccess: () => switchAuthView("forgot-confirm"),
    onFailure: (err) => showAuthError("forgot-error", err.message || "Could not send reset code."),
  });
});

/* ---- Forgot password step 2 ---- */
document.getElementById("btn-forgot-confirm").addEventListener("click", () => {
  clearAuthErrors();
  const code = document.getElementById("forgot-code").value.trim();
  const newPassword = document.getElementById("forgot-new-password").value;
  if (!pendingForgotEmail) return showAuthError("forgot-confirm-error", "Session expired, restart password reset.");
  const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: pendingForgotEmail, Pool: userPool });
  cognitoUser.confirmPassword(code, newPassword, {
    onSuccess: () => switchAuthView("login"),
    onFailure: (err) => showAuthError("forgot-confirm-error", err.message || "Reset failed."),
  });
});

/* ---- Logout ---- */
document.getElementById("btn-logout").addEventListener("click", () => {
  const user = userPool.getCurrentUser();
  if (user) user.signOut();
  if (ws) ws.close();
  session = { idToken: null, accessToken: null, email: null };
  document.getElementById("app-screen").style.display = "none";
  document.getElementById("auth-screen").style.display = "flex";
});

/* ---- Restore session on page load ---- */
window.addEventListener("DOMContentLoaded", () => {
  const cu = userPool.getCurrentUser();
  if (!cu) return;
  cu.getSession((err, sess) => {
    if (err || !sess || !sess.isValid()) return;
    session.idToken = sess.getIdToken().getJwtToken();
    session.accessToken = sess.getAccessToken().getJwtToken();
    session.email = cu.getUsername();
    enterApp();
  });
});

/* =========================================================================
   Enter main app
   ========================================================================= */
function enterApp() {
  document.getElementById("auth-screen").style.display = "none";
  document.getElementById("app-screen").style.display = "grid";
  document.getElementById("user-email").textContent = session.email;
  document.getElementById("user-initial").textContent = (session.email || "?").charAt(0).toUpperCase();

  document.getElementById("entry-date").value = new Date().toISOString().slice(0, 10);
  const lastInstrument = localStorage.getItem("ledgerline:lastInstrument");
  if (lastInstrument) document.getElementById("entry-instrument").value = lastInstrument;

  loadJournalEntries();
  connectWebSocket();
}

/* =========================================================================
   Journal: dropzone + form submit + history feed
   ========================================================================= */
let pendingImageBase64 = null;

const dropzone = document.getElementById("dropzone");
const fileInput = document.getElementById("file-input");
const dzPreview = document.getElementById("dropzone-preview");
const dzPlaceholder = document.getElementById("dropzone-placeholder");

dropzone.addEventListener("click", () => fileInput.click());
["dragenter", "dragover"].forEach((evt) =>
  dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.add("dragover"); })
);
["dragleave", "drop"].forEach((evt) =>
  dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.remove("dragover"); })
);
dropzone.addEventListener("drop", (e) => {
  const file = e.dataTransfer.files[0];
  if (file) handleImageFile(file);
});
fileInput.addEventListener("change", (e) => {
  const file = e.target.files[0];
  if (file) handleImageFile(file);
});

function handleImageFile(file) {
  const reader = new FileReader();
  reader.onload = () => {
    pendingImageBase64 = reader.result; // data URL, stripped server-side
    dzPreview.src = reader.result;
    dzPreview.classList.remove("hidden");
    dzPlaceholder.classList.add("hidden");
  };
  reader.readAsDataURL(file);
}

document.getElementById("entry-instrument").addEventListener("change", (e) => {
  localStorage.setItem("ledgerline:lastInstrument", e.target.value);
});

document.getElementById("journal-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const btn = document.getElementById("btn-save");
  btn.disabled = true;
  btn.textContent = "Analyzing…";

  const payload = {
    date: document.getElementById("entry-date").value,
    instrument: document.getElementById("entry-instrument").value,
    tradeDirection: document.getElementById("entry-direction").value,
    entryPrice: document.getElementById("entry-price").value || null,
    exitPrice: document.getElementById("exit-price").value || null,
    notes: document.getElementById("entry-notes").value,
    imageBase64: pendingImageBase64,
  };

  try {
    const res = await fetch(`$${CONFIG.HTTP_API_URL}/journal`, {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: session.idToken },
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error(`Server responded $${res.status}`);
    const entry = await res.json();
    prependEntryCard(entry);

    document.getElementById("journal-form").reset();
    document.getElementById("entry-date").value = new Date().toISOString().slice(0, 10);
    const lastInstrument = localStorage.getItem("ledgerline:lastInstrument");
    if (lastInstrument) document.getElementById("entry-instrument").value = lastInstrument;
    pendingImageBase64 = null;
    dzPreview.classList.add("hidden");
    dzPlaceholder.classList.remove("hidden");
  } catch (err) {
    alert("Could not save entry: " + err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = "Save & Analyze";
  }
});

async function loadJournalEntries() {
  try {
    const res = await fetch(`$${CONFIG.HTTP_API_URL}/journal`, {
      headers: { Authorization: session.idToken },
    });
    if (!res.ok) throw new Error(`Server responded $${res.status}`);
    const data = await res.json();
    const feed = document.getElementById("journal-feed");
    feed.innerHTML = "";
    if (!data.entries || data.entries.length === 0) {
      feed.innerHTML = '<div class="empty-state">No entries yet. Log your first trade above.</div>';
      return;
    }
    data.entries.forEach((entry) => appendEntryCard(entry));
  } catch (err) {
    console.error("Failed to load journal entries:", err);
  }
}

function prependEntryCard(entry) {
  const feed = document.getElementById("journal-feed");
  const empty = feed.querySelector(".empty-state");
  if (empty) empty.remove();
  const card = buildEntryCard(entry);
  feed.prepend(card);
}
function appendEntryCard(entry) {
  document.getElementById("journal-feed").appendChild(buildEntryCard(entry));
}

function buildEntryCard(entry) {
  const card = document.createElement("div");
  card.className = "entry-card";

  const ai = entry.AiAnalysis || {};
  const dirClass = (entry.TradeDirection || "").toLowerCase() === "short" ? "short" : "long";

  const chartHtml = entry.ChartImageUrl
    ? `<div class="entry-chart"><img src="$${entry.ChartImageUrl}" alt="Trade chart screenshot" loading="lazy" /></div>`
    : entry.ChartImageKey
    ? `<div class="entry-chart"><em style="font-size:12px;color:var(--text-faint);">Chart image could not be loaded.</em></div>`
    : "";

  card.innerHTML = `
    <div class="entry-head">
      <div class="entry-meta">
        <span class="instrument-tag">$${escapeHtml(entry.Instrument || "")}</span>
        <span class="dir-tag $${dirClass}">$${escapeHtml(entry.TradeDirection || "")}</span>
        <span class="entry-date">$${escapeHtml(entry.EntryDate || "")}</span>
      </div>
      <span style="color:var(--text-faint);font-size:12px;">▾</span>
    </div>
    <div class="entry-body">
      <div class="entry-notes">$${escapeHtml(entry.Notes || "No notes.")}</div>
      $${chartHtml}
      <div class="ai-block">
        <div class="ai-source">AI analysis · $${escapeHtml(ai.source || "pending")}</div>
        <div class="ai-summary">$${escapeHtml(ai.summary || "No analysis available.")}</div>
        <div class="ai-cols">
          <div>
            <h4>Strengths</h4>
            <ul>$${(ai.strengths || []).map((s) => `<li>$${escapeHtml(s)}</li>`).join("") || "<li>—</li>"}</ul>
          </div>
          <div>
            <h4>Mistakes</h4>
            <ul>$${(ai.mistakes || []).map((s) => `<li>$${escapeHtml(s)}</li>`).join("") || "<li>—</li>"}</ul>
          </div>
        </div>
      </div>
    </div>
  `;

  card.querySelector(".entry-head").addEventListener("click", () => {
    card.querySelector(".entry-body").classList.toggle("open");
  });

  return card;
}

function escapeHtml(str) {
  const div = document.createElement("div");
  div.textContent = str == null ? "" : String(str);
  return div.innerHTML;
}

/* =========================================================================
   WebSocket chat
   ========================================================================= */
let ws = null;
let wsReconnectTimer = null;

function setWsStatus(connected) {
  document.getElementById("ws-status-dot").classList.toggle("connected", connected);
  document.getElementById("ws-status-text").textContent = connected ? "Connected" : "Disconnected";
  document.getElementById("chat-input").disabled = !connected;
  document.getElementById("btn-send-chat").disabled = !connected;
}

function connectWebSocket() {
  if (!session.accessToken) return;
  const url = `$${CONFIG.WEBSOCKET_API_URL}?token=$${encodeURIComponent(session.accessToken)}`;
  ws = new WebSocket(url);

  ws.onopen = () => {
    setWsStatus(true);
    ws.send(JSON.stringify({ action: "getChatHistory" }));
  };

  ws.onclose = () => {
    setWsStatus(false);
    clearTimeout(wsReconnectTimer);
    wsReconnectTimer = setTimeout(connectWebSocket, 4000);
  };

  ws.onerror = () => setWsStatus(false);

  ws.onmessage = (event) => {
    let data;
    try {
      data = JSON.parse(event.data);
    } catch {
      return;
    }
    if (data.type === "history") {
      renderChatHistory(data.messages || []);
    } else if (data.type === "message") {
      appendChatMessage(data.message);
    } else if (data.type === "error") {
      console.warn("Chat error:", data.error);
    }
  };
}

function renderChatHistory(messages) {
  const feed = document.getElementById("chat-feed");
  feed.innerHTML = "";
  if (messages.length === 0) {
    feed.innerHTML = '<div class="empty-state">No messages yet. Say hello 👋</div>';
    return;
  }
  messages.forEach((m) => appendChatMessage(m, false));
  feed.scrollTop = feed.scrollHeight;
}

function appendChatMessage(msg, scroll = true) {
  const feed = document.getElementById("chat-feed");
  const empty = feed.querySelector(".empty-state");
  if (empty) empty.remove();

  const isOwn = msg.UserHandle === session.email;
  const time = new Date(msg.Timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

  const el = document.createElement("div");
  el.className = "chat-msg" + (isOwn ? " own" : "");
  el.innerHTML = `
    <div class="chat-msg-head">
      <span class="chat-handle">$${escapeHtml(msg.UserHandle)}</span>
      <span class="chat-time">$${time}</span>
    </div>
    <div class="chat-text">$${escapeHtml(msg.Message)}</div>
  `;
  feed.appendChild(el);
  if (scroll) feed.scrollTop = feed.scrollHeight;
}

function sendChatMessage() {
  const input = document.getElementById("chat-input");
  const text = input.value.trim();
  if (!text || !ws || ws.readyState !== WebSocket.OPEN) return;
  ws.send(JSON.stringify({ action: "sendMessage", message: text }));
  input.value = "";
}

document.getElementById("btn-send-chat").addEventListener("click", sendChatMessage);
document.getElementById("chat-input").addEventListener("keydown", (e) => {
  if (e.key === "Enter") sendChatMessage();
});
</script>
</body>
</html>
