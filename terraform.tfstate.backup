            "content": "\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\" /\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /\u003e\n\u003ctitle\u003eLedgerline — Trading Journal \u0026amp; Desk Chat\u003c/title\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\"\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700\u0026family=Inter:wght@400;500;600;700\u0026display=swap\" rel=\"stylesheet\"\u003e\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/amazon-cognito-identity-js@6.3.12/dist/amazon-cognito-identity.min.js\"\u003e\u003c/script\u003e\n\u003cstyle\u003e\n  :root{\n    --bg: #0a0c0f;\n    --panel: #12151a;\n    --panel-raised: #171b21;\n    --border: #232830;\n    --text: #e7e9ec;\n    --text-dim: #8a919c;\n    --text-faint: #565d68;\n    --amber: #f2a93b;\n    --amber-dim: #8a6423;\n    --long: #3ecf8e;\n    --short: #ef5b5b;\n    --font-display: 'IBM Plex Mono', monospace;\n    --font-body: 'Inter', sans-serif;\n    --radius: 3px;\n  }\n  *{ box-sizing:border-box; }\n  html,body{ margin:0; padding:0; }\n  body{\n    background: var(--bg);\n    color: var(--text);\n    font-family: var(--font-body);\n    min-height:100vh;\n    -webkit-font-smoothing: antialiased;\n  }\n  ::selection{ background: var(--amber-dim); color:#fff; }\n  a{ color: var(--amber); }\n  ::-webkit-scrollbar{ width:9px; height:9px; }\n  ::-webkit-scrollbar-track{ background: var(--bg); }\n  ::-webkit-scrollbar-thumb{ background: var(--border); border-radius: 6px; }\n\n  button{ font-family: var(--font-body); cursor:pointer; }\n  input, textarea, select{ font-family: var(--font-body); }\n\n  .hidden{ display:none !important; }\n\n  /* ---------- Auth screens ---------- */\n  #auth-screen{\n    min-height:100vh;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    padding:24px;\n    background:\n      radial-gradient(circle at 20% 10%, rgba(242,169,59,0.05), transparent 40%),\n      var(--bg);\n  }\n  .auth-card{\n    width:100%;\n    max-width:400px;\n    background: var(--panel);\n    border:1px solid var(--border);\n    border-radius: 6px;\n    padding:36px 32px;\n  }\n  .auth-brand{\n    font-family: var(--font-display);\n    font-size:13px;\n    letter-spacing:0.18em;\n    color: var(--amber);\n    text-transform:uppercase;\n    margin-bottom:6px;\n  }\n  .auth-title{\n    font-size:22px;\n    font-weight:600;\n    margin:0 0 24px 0;\n  }\n  .field{ margin-bottom:16px; }\n  .field label{\n    display:block;\n    font-size:12px;\n    color: var(--text-dim);\n    margin-bottom:6px;\n    letter-spacing:0.02em;\n  }\n  .field input{\n    width:100%;\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n    color: var(--text);\n    padding:10px 12px;\n    border-radius: var(--radius);\n    font-size:14px;\n    outline:none;\n    transition: border-color .15s;\n  }\n  .field input:focus{ border-color: var(--amber); }\n  .btn-primary{\n    width:100%;\n    background: var(--amber);\n    color:#1a1200;\n    font-weight:600;\n    border:none;\n    padding:11px;\n    border-radius: var(--radius);\n    font-size:14px;\n    transition: filter .15s;\n  }\n  .btn-primary:hover{ filter:brightness(1.08); }\n  .btn-primary:disabled{ opacity:0.5; cursor:not-allowed; }\n  .btn-link{\n    background:none;\n    border:none;\n    color: var(--text-dim);\n    font-size:13px;\n    padding:0;\n    text-decoration:underline;\n    text-underline-offset:3px;\n  }\n  .btn-link:hover{ color: var(--amber); }\n  .auth-switch{ margin-top:18px; text-align:center; font-size:13px; color:var(--text-dim); }\n  .auth-error{\n    background: rgba(239,91,91,0.1);\n    border:1px solid rgba(239,91,91,0.3);\n    color: var(--short);\n    font-size:13px;\n    padding:10px 12px;\n    border-radius: var(--radius);\n    margin-bottom:16px;\n  }\n  .auth-note{ font-size:12px; color: var(--text-faint); margin-bottom:16px; line-height:1.5; }\n\n  /* ---------- App shell ---------- */\n  #app-screen{ display:none; min-height:100vh; grid-template-rows:auto 1fr; }\n  header.topbar{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:14px 24px;\n    border-bottom:1px solid var(--border);\n    background: var(--panel);\n  }\n  .topbar-left{ display:flex; align-items:center; gap:10px; }\n  .logo-mark{\n    width:26px; height:26px;\n    border:1.5px solid var(--amber);\n    border-radius:4px;\n    display:flex; align-items:center; justify-content:center;\n    font-family: var(--font-display);\n    color: var(--amber);\n    font-weight:700;\n    font-size:13px;\n  }\n  .topbar-title{ font-family: var(--font-display); font-size:15px; letter-spacing:0.06em; }\n  .topbar-title span{ color: var(--text-faint); }\n  .topbar-right{ display:flex; align-items:center; gap:16px; }\n  .user-chip{\n    font-size:13px; color:var(--text-dim);\n    display:flex; align-items:center; gap:8px;\n  }\n  .avatar-dot{\n    width:26px; height:26px; border-radius:50%;\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n    display:flex; align-items:center; justify-content:center;\n    font-size:11px; font-weight:600; color:var(--amber);\n  }\n  .btn-ghost{\n    background:none; border:1px solid var(--border);\n    color: var(--text-dim);\n    padding:7px 14px; border-radius: var(--radius);\n    font-size:13px;\n    transition: all .15s;\n  }\n  .btn-ghost:hover{ border-color: var(--short); color: var(--short); }\n\n  .layout{\n    display:grid;\n    grid-template-columns: 1fr 360px;\n    gap:0;\n    min-height: calc(100vh - 57px);\n  }\n  @media (max-width: 940px){\n    .layout{ grid-template-columns: 1fr; }\n  }\n\n  main.workspace{ padding:28px 32px; overflow-y:auto; }\n  .section-label{\n    font-family: var(--font-display);\n    font-size:11px;\n    letter-spacing:0.14em;\n    color: var(--text-faint);\n    text-transform:uppercase;\n    margin-bottom:14px;\n    display:flex; align-items:center; gap:10px;\n  }\n  .section-label::after{\n    content:''; flex:1; height:1px; background: var(--border);\n  }\n\n  /* ---------- Journal form ---------- */\n  .journal-form{\n    background: var(--panel);\n    border:1px solid var(--border);\n    border-radius:6px;\n    padding:22px;\n    margin-bottom:36px;\n  }\n  .form-grid{\n    display:grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap:14px;\n    margin-bottom:14px;\n  }\n  @media (max-width: 640px){ .form-grid{ grid-template-columns: 1fr 1fr; } }\n  .form-grid .field{ margin-bottom:0; }\n  select{\n    width:100%;\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n    color: var(--text);\n    padding:10px 12px;\n    border-radius: var(--radius);\n    font-size:14px;\n    outline:none;\n  }\n  textarea{\n    width:100%;\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n    color: var(--text);\n    padding:10px 12px;\n    border-radius: var(--radius);\n    font-size:14px;\n    min-height:90px;\n    resize:vertical;\n    outline:none;\n  }\n  textarea:focus, select:focus{ border-color: var(--amber); }\n\n  .dropzone{\n    border:1.5px dashed var(--border);\n    border-radius: var(--radius);\n    padding:20px;\n    text-align:center;\n    color: var(--text-faint);\n    font-size:13px;\n    cursor:pointer;\n    transition: border-color .15s, background .15s;\n    margin-bottom:14px;\n  }\n  .dropzone.dragover{ border-color: var(--amber); background: rgba(242,169,59,0.05); }\n  .dropzone img{ max-width:100%; max-height:180px; border-radius: var(--radius); }\n\n  .form-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:6px; }\n  .btn-primary.small{ width:auto; padding:10px 22px; }\n\n  /* ---------- Journal history ---------- */\n  .entry-card{\n    background: var(--panel);\n    border:1px solid var(--border);\n    border-radius:6px;\n    margin-bottom:12px;\n    overflow:hidden;\n  }\n  .entry-head{\n    display:flex; align-items:center; justify-content:space-between;\n    padding:14px 18px;\n    cursor:pointer;\n  }\n  .entry-head:hover{ background: var(--panel-raised); }\n  .entry-meta{ display:flex; align-items:center; gap:12px; font-size:13px; }\n  .instrument-tag{\n    font-family: var(--font-display);\n    font-size:12px; font-weight:700;\n    padding:3px 8px; border-radius:3px;\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n  }\n  .dir-tag{ font-size:11px; font-weight:700; padding:3px 8px; border-radius:3px; letter-spacing:0.04em; }\n  .dir-tag.long{ color: var(--long); background: rgba(62,207,142,0.12); }\n  .dir-tag.short{ color: var(--short); background: rgba(239,91,91,0.12); }\n  .entry-date{ color: var(--text-dim); font-family: var(--font-display); font-size:12px; }\n  .entry-body{ padding:0 18px 18px 18px; display:none; border-top:1px solid var(--border); }\n  .entry-body.open{ display:block; }\n  .entry-notes{ font-size:14px; color: var(--text-dim); margin:14px 0; line-height:1.6; }\n  .entry-chart img{ max-width:100%; border-radius: var(--radius); border:1px solid var(--border); margin-bottom:14px; }\n  .ai-block{\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n    border-radius: var(--radius);\n    padding:14px 16px;\n  }\n  .ai-source{ font-family: var(--font-display); font-size:10px; color: var(--text-faint); letter-spacing:0.1em; text-transform:uppercase; margin-bottom:8px; }\n  .ai-summary{ font-size:13px; margin-bottom:10px; }\n  .ai-cols{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }\n  .ai-cols h4{ font-size:11px; color: var(--text-faint); margin:0 0 6px 0; text-transform:uppercase; letter-spacing:0.06em; }\n  .ai-cols ul{ margin:0; padding-left:16px; font-size:13px; color: var(--text-dim); }\n  .empty-state{ color: var(--text-faint); font-size:13px; padding:20px; text-align:center; }\n\n  /* ---------- Chat sidebar ---------- */\n  aside.chat-panel{\n    background: var(--panel);\n    border-left:1px solid var(--border);\n    display:flex; flex-direction:column;\n    height: calc(100vh - 57px);\n    position:sticky; top:57px;\n  }\n  .chat-header{\n    padding:16px 18px;\n    border-bottom:1px solid var(--border);\n    display:flex; align-items:center; justify-content:space-between;\n  }\n  .chat-title{ font-family: var(--font-display); font-size:13px; letter-spacing:0.06em; }\n  .status-indicator{ display:flex; align-items:center; gap:6px; font-size:11px; color: var(--text-dim); }\n  .status-dot{ width:7px; height:7px; border-radius:50%; background: var(--short); transition: background .2s; }\n  .status-dot.connected{ background: var(--long); box-shadow: 0 0 6px rgba(62,207,142,0.6); }\n\n  .chat-feed{ flex:1; overflow-y:auto; padding:14px 18px; display:flex; flex-direction:column; gap:14px; }\n  .chat-msg{ font-size:13px; }\n  .chat-msg-head{ display:flex; align-items:baseline; gap:8px; margin-bottom:2px; }\n  .chat-handle{ font-weight:600; color: var(--amber); font-size:12px; }\n  .chat-time{ font-size:10px; color: var(--text-faint); font-family: var(--font-display); }\n  .chat-text{ color: var(--text); line-height:1.5; word-break:break-word; }\n  .chat-msg.own .chat-handle{ color: var(--long); }\n\n  .chat-input-row{\n    display:flex; gap:8px;\n    padding:14px 18px;\n    border-top:1px solid var(--border);\n  }\n  .chat-input-row input{\n    flex:1;\n    background: var(--panel-raised);\n    border:1px solid var(--border);\n    color: var(--text);\n    padding:9px 12px;\n    border-radius: var(--radius);\n    font-size:13px;\n    outline:none;\n  }\n  .chat-input-row input:focus{ border-color: var(--amber); }\n  .btn-send{\n    background: var(--amber); color:#1a1200; border:none;\n    padding:9px 16px; border-radius: var(--radius); font-weight:600; font-size:13px;\n  }\n  .btn-send:disabled{ opacity:0.4; cursor:not-allowed; }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003c!-- ============ CONFIG BANNER (shown until config filled in) ============ --\u003e\n\u003cdiv id=\"config-warning\" class=\"hidden\" style=\"background:#3a1f0a;color:#f2a93b;padding:10px 20px;font-size:13px;font-family:'IBM Plex Mono',monospace;text-align:center;\"\u003e\n  ⚠ Fill in the CONFIG object at the top of the \u0026lt;script\u0026gt; tag with your Terraform outputs before using this app.\n\u003c/div\u003e\n\n\u003c!-- ============ AUTH SCREEN ============ --\u003e\n\u003cdiv id=\"auth-screen\"\u003e\n  \u003cdiv class=\"auth-card\"\u003e\n    \u003cdiv class=\"auth-brand\"\u003eLedgerline\u003c/div\u003e\n\n    \u003c!-- LOGIN VIEW --\u003e\n    \u003cdiv id=\"view-login\"\u003e\n      \u003ch1 class=\"auth-title\"\u003eSign in\u003c/h1\u003e\n      \u003cdiv id=\"login-error\" class=\"auth-error hidden\"\u003e\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003eEmail\u003c/label\u003e\u003cinput type=\"email\" id=\"login-email\" autocomplete=\"username\"/\u003e\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003ePassword\u003c/label\u003e\u003cinput type=\"password\" id=\"login-password\" autocomplete=\"current-password\"/\u003e\u003c/div\u003e\n      \u003cbutton class=\"btn-primary\" id=\"btn-login\"\u003eSign in\u003c/button\u003e\n      \u003cdiv class=\"auth-switch\"\u003e\n        \u003cbutton class=\"btn-link\" data-goto=\"signup\"\u003eCreate an account\u003c/button\u003e ·\n        \u003cbutton class=\"btn-link\" data-goto=\"forgot\"\u003eForgot password?\u003c/button\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- SIGNUP VIEW --\u003e\n    \u003cdiv id=\"view-signup\" class=\"hidden\"\u003e\n      \u003ch1 class=\"auth-title\"\u003eCreate account\u003c/h1\u003e\n      \u003cdiv id=\"signup-error\" class=\"auth-error hidden\"\u003e\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003eEmail\u003c/label\u003e\u003cinput type=\"email\" id=\"signup-email\" autocomplete=\"username\"/\u003e\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003ePassword\u003c/label\u003e\u003cinput type=\"password\" id=\"signup-password\" autocomplete=\"new-password\"/\u003e\u003c/div\u003e\n      \u003cdiv class=\"auth-note\"\u003eMin 8 characters, one uppercase letter, one lowercase letter, one number.\u003c/div\u003e\n      \u003cbutton class=\"btn-primary\" id=\"btn-signup\"\u003eSign up\u003c/button\u003e\n      \u003cdiv class=\"auth-switch\"\u003e\u003cbutton class=\"btn-link\" data-goto=\"login\"\u003eBack to sign in\u003c/button\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- CONFIRM SIGNUP VIEW --\u003e\n    \u003cdiv id=\"view-confirm\" class=\"hidden\"\u003e\n      \u003ch1 class=\"auth-title\"\u003eVerify email\u003c/h1\u003e\n      \u003cdiv id=\"confirm-error\" class=\"auth-error hidden\"\u003e\u003c/div\u003e\n      \u003cdiv class=\"auth-note\"\u003eEnter the 6-digit code we emailed you.\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003eVerification code\u003c/label\u003e\u003cinput type=\"text\" id=\"confirm-code\" inputmode=\"numeric\"/\u003e\u003c/div\u003e\n      \u003cbutton class=\"btn-primary\" id=\"btn-confirm\"\u003eVerify \u0026amp; continue\u003c/button\u003e\n      \u003cdiv class=\"auth-switch\"\u003e\u003cbutton class=\"btn-link\" data-goto=\"login\"\u003eBack to sign in\u003c/button\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- FORGOT PASSWORD STEP 1 --\u003e\n    \u003cdiv id=\"view-forgot\" class=\"hidden\"\u003e\n      \u003ch1 class=\"auth-title\"\u003eReset password\u003c/h1\u003e\n      \u003cdiv id=\"forgot-error\" class=\"auth-error hidden\"\u003e\u003c/div\u003e\n      \u003cdiv class=\"auth-note\"\u003eWe'll email you a reset code.\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003eEmail\u003c/label\u003e\u003cinput type=\"email\" id=\"forgot-email\" autocomplete=\"username\"/\u003e\u003c/div\u003e\n      \u003cbutton class=\"btn-primary\" id=\"btn-forgot-send\"\u003eSend reset code\u003c/button\u003e\n      \u003cdiv class=\"auth-switch\"\u003e\u003cbutton class=\"btn-link\" data-goto=\"login\"\u003eBack to sign in\u003c/button\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- FORGOT PASSWORD STEP 2 --\u003e\n    \u003cdiv id=\"view-forgot-confirm\" class=\"hidden\"\u003e\n      \u003ch1 class=\"auth-title\"\u003eSet new password\u003c/h1\u003e\n      \u003cdiv id=\"forgot-confirm-error\" class=\"auth-error hidden\"\u003e\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003eReset code\u003c/label\u003e\u003cinput type=\"text\" id=\"forgot-code\" inputmode=\"numeric\"/\u003e\u003c/div\u003e\n      \u003cdiv class=\"field\"\u003e\u003clabel\u003eNew password\u003c/label\u003e\u003cinput type=\"password\" id=\"forgot-new-password\" autocomplete=\"new-password\"/\u003e\u003c/div\u003e\n      \u003cbutton class=\"btn-primary\" id=\"btn-forgot-confirm\"\u003eUpdate password\u003c/button\u003e\n      \u003cdiv class=\"auth-switch\"\u003e\u003cbutton class=\"btn-link\" data-goto=\"login\"\u003eBack to sign in\u003c/button\u003e\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003c!-- ============ MAIN APP SCREEN ============ --\u003e\n\u003cdiv id=\"app-screen\"\u003e\n  \u003cheader class=\"topbar\"\u003e\n    \u003cdiv class=\"topbar-left\"\u003e\n      \u003cdiv class=\"logo-mark\"\u003eL\u003c/div\u003e\n      \u003cdiv class=\"topbar-title\"\u003eLEDGERLINE \u003cspan\u003e/ desk journal\u003c/span\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"topbar-right\"\u003e\n      \u003cdiv class=\"user-chip\"\u003e\n        \u003cdiv class=\"avatar-dot\" id=\"user-initial\"\u003e?\u003c/div\u003e\n        \u003cspan id=\"user-email\"\u003e—\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cbutton class=\"btn-ghost\" id=\"btn-logout\"\u003eLog out\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/header\u003e\n\n  \u003cdiv class=\"layout\"\u003e\n    \u003cmain class=\"workspace\"\u003e\n      \u003cdiv class=\"section-label\"\u003eNew entry\u003c/div\u003e\n      \u003cform class=\"journal-form\" id=\"journal-form\"\u003e\n        \u003cdiv class=\"form-grid\"\u003e\n          \u003cdiv class=\"field\"\u003e\n            \u003clabel\u003eDate\u003c/label\u003e\n            \u003cinput type=\"date\" id=\"entry-date\" required /\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"field\"\u003e\n            \u003clabel\u003eInstrument\u003c/label\u003e\n            \u003cselect id=\"entry-instrument\" required\u003e\n              \u003coption value=\"\"\u003eSelect…\u003c/option\u003e\n              \u003coption value=\"ES\"\u003eES\u003c/option\u003e\n              \u003coption value=\"NQ\"\u003eNQ\u003c/option\u003e\n              \u003coption value=\"MES\"\u003eMES\u003c/option\u003e\n              \u003coption value=\"MNQ\"\u003eMNQ\u003c/option\u003e\n            \u003c/select\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"field\"\u003e\n            \u003clabel\u003eDirection\u003c/label\u003e\n            \u003cselect id=\"entry-direction\" required\u003e\n              \u003coption value=\"Long\"\u003eLong\u003c/option\u003e\n              \u003coption value=\"Short\"\u003eShort\u003c/option\u003e\n            \u003c/select\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"field\"\u003e\n            \u003clabel\u003eEntry / Exit\u003c/label\u003e\n            \u003cdiv style=\"display:flex; gap:6px;\"\u003e\n              \u003cinput type=\"number\" step=\"0.01\" id=\"entry-price\" placeholder=\"Entry\" style=\"background:var(--panel-raised);border:1px solid var(--border);color:var(--text);padding:10px 8px;border-radius:3px;width:50%;outline:none;\"/\u003e\n              \u003cinput type=\"number\" step=\"0.01\" id=\"exit-price\" placeholder=\"Exit\" style=\"background:var(--panel-raised);border:1px solid var(--border);color:var(--text);padding:10px 8px;border-radius:3px;width:50%;outline:none;\"/\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"dropzone\" id=\"dropzone\"\u003e\n          \u003cdiv id=\"dropzone-placeholder\"\u003eDrop a chart screenshot here, or click to upload\u003c/div\u003e\n          \u003cimg id=\"dropzone-preview\" class=\"hidden\" /\u003e\n          \u003cinput type=\"file\" id=\"file-input\" accept=\"image/*\" class=\"hidden\" /\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"field\"\u003e\n          \u003clabel\u003eTrade rationale / notes\u003c/label\u003e\n          \u003ctextarea id=\"entry-notes\" placeholder=\"What was the setup? What went right or wrong?\"\u003e\u003c/textarea\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"form-actions\"\u003e\n          \u003cbutton type=\"submit\" class=\"btn-primary small\" id=\"btn-save\"\u003eSave \u0026amp; Analyze\u003c/button\u003e\n        \u003c/div\u003e\n      \u003c/form\u003e\n\n      \u003cdiv class=\"section-label\"\u003eJournal history\u003c/div\u003e\n      \u003cdiv id=\"journal-feed\"\u003e\n        \u003cdiv class=\"empty-state\"\u003eNo entries yet. Log your first trade above.\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/main\u003e\n\n    \u003caside class=\"chat-panel\"\u003e\n      \u003cdiv class=\"chat-header\"\u003e\n        \u003cdiv class=\"chat-title\"\u003eDESK CHAT\u003c/div\u003e\n        \u003cdiv class=\"status-indicator\"\u003e\n          \u003cdiv class=\"status-dot\" id=\"ws-status-dot\"\u003e\u003c/div\u003e\n          \u003cspan id=\"ws-status-text\"\u003eDisconnected\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"chat-feed\" id=\"chat-feed\"\u003e\n        \u003cdiv class=\"empty-state\"\u003eConnecting to the trading desk…\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"chat-input-row\"\u003e\n        \u003cinput type=\"text\" id=\"chat-input\" placeholder=\"Message the desk…\" maxlength=\"2000\" disabled /\u003e\n        \u003cbutton class=\"btn-send\" id=\"btn-send-chat\" disabled\u003eSend\u003c/button\u003e\n      \u003c/div\u003e\n    \u003c/aside\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cscript\u003e\n/* =========================================================================\n   CONFIG — fill these in with your `terraform output` values after `apply`\n   ========================================================================= */\nconst CONFIG = {\n  AWS_REGION:            \"us-west-1\",\n  COGNITO_USER_POOL_ID:  \"us-west-1_dWZDGbJ2l\",\n  COGNITO_CLIENT_ID:     \"7a88dmmtmooec04aof5m706geq\",\n  HTTP_API_URL:          \"https://974eu0lr79.execute-api.us-west-1.amazonaws.com/\",\n  WEBSOCKET_API_URL:     \"wss://pw26unxiq1.execute-api.us-west-1.amazonaws.com/prod\"\n};\n\nif (CONFIG.COGNITO_USER_POOL_ID.includes(\"XXXX\")) {\n  document.getElementById(\"config-warning\").classList.remove(\"hidden\");\n}\n\n/* =========================================================================\n   Cognito setup\n   ========================================================================= */\nconst poolData = {\n  UserPoolId: CONFIG.COGNITO_USER_POOL_ID,\n  ClientId: CONFIG.COGNITO_CLIENT_ID,\n};\nconst userPool = new AmazonCognitoIdentity.CognitoUserPool(poolData);\n\nlet currentCognitoUser = null;\nlet pendingForgotEmail = null;\nlet session = { idToken: null, accessToken: null, email: null };\n\nfunction showAuthError(viewId, message) {\n  const el = document.getElementById(viewId);\n  el.textContent = message;\n  el.classList.remove(\"hidden\");\n}\nfunction clearAuthErrors() {\n  document.querySelectorAll(\".auth-error\").forEach((el) =\u003e el.classList.add(\"hidden\"));\n}\n\ndocument.querySelectorAll(\"[data-goto]\").forEach((btn) =\u003e {\n  btn.addEventListener(\"click\", () =\u003e switchAuthView(btn.dataset.goto));\n});\nfunction switchAuthView(name) {\n  clearAuthErrors();\n  [\"login\", \"signup\", \"confirm\", \"forgot\", \"forgot-confirm\"].forEach((v) =\u003e {\n    document.getElementById(\"view-\" + v).classList.toggle(\"hidden\", v !== name);\n  });\n}\n\n/* ---- Login ---- */\ndocument.getElementById(\"btn-login\").addEventListener(\"click\", () =\u003e {\n  clearAuthErrors();\n  const email = document.getElementById(\"login-email\").value.trim();\n  const password = document.getElementById(\"login-password\").value;\n  if (!email || !password) return showAuthError(\"login-error\", \"Email and password are required.\");\n\n  const authDetails = new AmazonCognitoIdentity.AuthenticationDetails({ Username: email, Password: password });\n  const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: email, Pool: userPool });\n  currentCognitoUser = cognitoUser;\n\n  cognitoUser.authenticateUser(authDetails, {\n    onSuccess: (result) =\u003e {\n      session.idToken = result.getIdToken().getJwtToken();\n      session.accessToken = result.getAccessToken().getJwtToken();\n      session.email = email;\n      enterApp();\n    },\n    onFailure: (err) =\u003e showAuthError(\"login-error\", err.message || \"Login failed.\"),\n  });\n});\n\n/* ---- Signup ---- */\ndocument.getElementById(\"btn-signup\").addEventListener(\"click\", () =\u003e {\n  clearAuthErrors();\n  const email = document.getElementById(\"signup-email\").value.trim();\n  const password = document.getElementById(\"signup-password\").value;\n  if (!email || !password) return showAuthError(\"signup-error\", \"Email and password are required.\");\n\n  const attributeList = [new AmazonCognitoIdentity.CognitoUserAttribute({ Name: \"email\", Value: email })];\n\n  userPool.signUp(email, password, attributeList, null, (err, result) =\u003e {\n    if (err) return showAuthError(\"signup-error\", err.message || \"Sign up failed.\");\n    currentCognitoUser = result.user;\n    switchAuthView(\"confirm\");\n  });\n});\n\n/* ---- Confirm signup ---- */\ndocument.getElementById(\"btn-confirm\").addEventListener(\"click\", () =\u003e {\n  clearAuthErrors();\n  const code = document.getElementById(\"confirm-code\").value.trim();\n  if (!currentCognitoUser) return showAuthError(\"confirm-error\", \"Session expired, please sign up again.\");\n  currentCognitoUser.confirmRegistration(code, true, (err) =\u003e {\n    if (err) return showAuthError(\"confirm-error\", err.message || \"Verification failed.\");\n    switchAuthView(\"login\");\n  });\n});\n\n/* ---- Forgot password step 1 ---- */\ndocument.getElementById(\"btn-forgot-send\").addEventListener(\"click\", () =\u003e {\n  clearAuthErrors();\n  const email = document.getElementById(\"forgot-email\").value.trim();\n  if (!email) return showAuthError(\"forgot-error\", \"Enter your email.\");\n  pendingForgotEmail = email;\n  const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: email, Pool: userPool });\n  cognitoUser.forgotPassword({\n    onSuccess: () =\u003e switchAuthView(\"forgot-confirm\"),\n    onFailure: (err) =\u003e showAuthError(\"forgot-error\", err.message || \"Could not send reset code.\"),\n  });\n});\n\n/* ---- Forgot password step 2 ---- */\ndocument.getElementById(\"btn-forgot-confirm\").addEventListener(\"click\", () =\u003e {\n  clearAuthErrors();\n  const code = document.getElementById(\"forgot-code\").value.trim();\n  const newPassword = document.getElementById(\"forgot-new-password\").value;\n  if (!pendingForgotEmail) return showAuthError(\"forgot-confirm-error\", \"Session expired, restart password reset.\");\n  const cognitoUser = new AmazonCognitoIdentity.CognitoUser({ Username: pendingForgotEmail, Pool: userPool });\n  cognitoUser.confirmPassword(code, newPassword, {\n    onSuccess: () =\u003e switchAuthView(\"login\"),\n    onFailure: (err) =\u003e showAuthError(\"forgot-confirm-error\", err.message || \"Reset failed.\"),\n  });\n});\n\n/* ---- Logout ---- */\ndocument.getElementById(\"btn-logout\").addEventListener(\"click\", () =\u003e {\n  const user = userPool.getCurrentUser();\n  if (user) user.signOut();\n  if (ws) ws.close();\n  session = { idToken: null, accessToken: null, email: null };\n  document.getElementById(\"app-screen\").style.display = \"none\";\n  document.getElementById(\"auth-screen\").style.display = \"flex\";\n});\n\n/* ---- Restore session on page load ---- */\nwindow.addEventListener(\"DOMContentLoaded\", () =\u003e {\n  const cu = userPool.getCurrentUser();\n  if (!cu) return;\n  cu.getSession((err, sess) =\u003e {\n    if (err || !sess || !sess.isValid()) return;\n    session.idToken = sess.getIdToken().getJwtToken();\n    session.accessToken = sess.getAccessToken().getJwtToken();\n    session.email = cu.getUsername();\n    enterApp();\n  });\n});\n\n/* =========================================================================\n   Enter main app\n   ========================================================================= */\nfunction enterApp() {\n  document.getElementById(\"auth-screen\").style.display = \"none\";\n  document.getElementById(\"app-screen\").style.display = \"grid\";\n  document.getElementById(\"user-email\").textContent = session.email;\n  document.getElementById(\"user-initial\").textContent = (session.email || \"?\").charAt(0).toUpperCase();\n\n  document.getElementById(\"entry-date\").value = new Date().toISOString().slice(0, 10);\n  const lastInstrument = localStorage.getItem(\"ledgerline:lastInstrument\");\n  if (lastInstrument) document.getElementById(\"entry-instrument\").value = lastInstrument;\n\n  loadJournalEntries();\n  connectWebSocket();\n}\n\n/* =========================================================================\n   Journal: dropzone + form submit + history feed\n   ========================================================================= */\nlet pendingImageBase64 = null;\n\nconst dropzone = document.getElementById(\"dropzone\");\nconst fileInput = document.getElementById(\"file-input\");\nconst dzPreview = document.getElementById(\"dropzone-preview\");\nconst dzPlaceholder = document.getElementById(\"dropzone-placeholder\");\n\ndropzone.addEventListener(\"click\", () =\u003e fileInput.click());\n[\"dragenter\", \"dragover\"].forEach((evt) =\u003e\n  dropzone.addEventListener(evt, (e) =\u003e { e.preventDefault(); dropzone.classList.add(\"dragover\"); })\n);\n[\"dragleave\", \"drop\"].forEach((evt) =\u003e\n  dropzone.addEventListener(evt, (e) =\u003e { e.preventDefault(); dropzone.classList.remove(\"dragover\"); })\n);\ndropzone.addEventListener(\"drop\", (e) =\u003e {\n  const file = e.dataTransfer.files[0];\n  if (file) handleImageFile(file);\n});\nfileInput.addEventListener(\"change\", (e) =\u003e {\n  const file = e.target.files[0];\n  if (file) handleImageFile(file);\n});\n\nfunction handleImageFile(file) {\n  const reader = new FileReader();\n  reader.onload = () =\u003e {\n    pendingImageBase64 = reader.result; // data URL, stripped server-side\n    dzPreview.src = reader.result;\n    dzPreview.classList.remove(\"hidden\");\n    dzPlaceholder.classList.add(\"hidden\");\n  };\n  reader.readAsDataURL(file);\n}\n\ndocument.getElementById(\"entry-instrument\").addEventListener(\"change\", (e) =\u003e {\n  localStorage.setItem(\"ledgerline:lastInstrument\", e.target.value);\n});\n\ndocument.getElementById(\"journal-form\").addEventListener(\"submit\", async (e) =\u003e {\n  e.preventDefault();\n  const btn = document.getElementById(\"btn-save\");\n  btn.disabled = true;\n  btn.textContent = \"Analyzing…\";\n\n  const payload = {\n    date: document.getElementById(\"entry-date\").value,\n    instrument: document.getElementById(\"entry-instrument\").value,\n    tradeDirection: document.getElementById(\"entry-direction\").value,\n    entryPrice: document.getElementById(\"entry-price\").value || null,\n    exitPrice: document.getElementById(\"exit-price\").value || null,\n    notes: document.getElementById(\"entry-notes\").value,\n    imageBase64: pendingImageBase64,\n  };\n\n  try {\n    const res = await fetch(`${CONFIG.HTTP_API_URL}/journal`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\", Authorization: session.idToken },\n      body: JSON.stringify(payload),\n    });\n    if (!res.ok) throw new Error(`Server responded ${res.status}`);\n    const entry = await res.json();\n    prependEntryCard(entry);\n\n    document.getElementById(\"journal-form\").reset();\n    document.getElementById(\"entry-date\").value = new Date().toISOString().slice(0, 10);\n    const lastInstrument = localStorage.getItem(\"ledgerline:lastInstrument\");\n    if (lastInstrument) document.getElementById(\"entry-instrument\").value = lastInstrument;\n    pendingImageBase64 = null;\n    dzPreview.classList.add(\"hidden\");\n    dzPlaceholder.classList.remove(\"hidden\");\n  } catch (err) {\n    alert(\"Could not save entry: \" + err.message);\n  } finally {\n    btn.disabled = false;\n    btn.textContent = \"Save \u0026 Analyze\";\n  }\n});\n\nasync function loadJournalEntries() {\n  try {\n    const res = await fetch(`${CONFIG.HTTP_API_URL}/journal`, {\n      headers: { Authorization: session.idToken },\n    });\n    if (!res.ok) throw new Error(`Server responded ${res.status}`);\n    const data = await res.json();\n    const feed = document.getElementById(\"journal-feed\");\n    feed.innerHTML = \"\";\n    if (!data.entries || data.entries.length === 0) {\n      feed.innerHTML = '\u003cdiv class=\"empty-state\"\u003eNo entries yet. Log your first trade above.\u003c/div\u003e';\n      return;\n    }\n    data.entries.forEach((entry) =\u003e appendEntryCard(entry));\n  } catch (err) {\n    console.error(\"Failed to load journal entries:\", err);\n  }\n}\n\nfunction prependEntryCard(entry) {\n  const feed = document.getElementById(\"journal-feed\");\n  const empty = feed.querySelector(\".empty-state\");\n  if (empty) empty.remove();\n  const card = buildEntryCard(entry);\n  feed.prepend(card);\n}\nfunction appendEntryCard(entry) {\n  document.getElementById(\"journal-feed\").appendChild(buildEntryCard(entry));\n}\n\nfunction buildEntryCard(entry) {\n  const card = document.createElement(\"div\");\n  card.className = \"entry-card\";\n\n  const ai = entry.AiAnalysis || {};\n  const dirClass = (entry.TradeDirection || \"\").toLowerCase() === \"short\" ? \"short\" : \"long\";\n\n  const chartHtml = entry.ChartImageUrl\n    ? `\u003cdiv class=\"entry-chart\"\u003e\u003cimg src=\"${entry.ChartImageUrl}\" alt=\"Trade chart screenshot\" loading=\"lazy\" /\u003e\u003c/div\u003e`\n    : entry.ChartImageKey\n    ? `\u003cdiv class=\"entry-chart\"\u003e\u003cem style=\"font-size:12px;color:var(--text-faint);\"\u003eChart image could not be loaded.\u003c/em\u003e\u003c/div\u003e`\n    : \"\";\n\n  card.innerHTML = `\n    \u003cdiv class=\"entry-head\"\u003e\n      \u003cdiv class=\"entry-meta\"\u003e\n        \u003cspan class=\"instrument-tag\"\u003e${escapeHtml(entry.Instrument || \"\")}\u003c/span\u003e\n        \u003cspan class=\"dir-tag ${dirClass}\"\u003e${escapeHtml(entry.TradeDirection || \"\")}\u003c/span\u003e\n        \u003cspan class=\"entry-date\"\u003e${escapeHtml(entry.EntryDate || \"\")}\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cspan style=\"color:var(--text-faint);font-size:12px;\"\u003e▾\u003c/span\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"entry-body\"\u003e\n      \u003cdiv class=\"entry-notes\"\u003e${escapeHtml(entry.Notes || \"No notes.\")}\u003c/div\u003e\n      ${chartHtml}\n      \u003cdiv class=\"ai-block\"\u003e\n        \u003cdiv class=\"ai-source\"\u003eAI analysis · ${escapeHtml(ai.source || \"pending\")}\u003c/div\u003e\n        \u003cdiv class=\"ai-summary\"\u003e${escapeHtml(ai.summary || \"No analysis available.\")}\u003c/div\u003e\n        \u003cdiv class=\"ai-cols\"\u003e\n          \u003cdiv\u003e\n            \u003ch4\u003eStrengths\u003c/h4\u003e\n            \u003cul\u003e${(ai.strengths || []).map((s) =\u003e `\u003cli\u003e${escapeHtml(s)}\u003c/li\u003e`).join(\"\") || \"\u003cli\u003e—\u003c/li\u003e\"}\u003c/ul\u003e\n          \u003c/div\u003e\n          \u003cdiv\u003e\n            \u003ch4\u003eMistakes\u003c/h4\u003e\n            \u003cul\u003e${(ai.mistakes || []).map((s) =\u003e `\u003cli\u003e${escapeHtml(s)}\u003c/li\u003e`).join(\"\") || \"\u003cli\u003e—\u003c/li\u003e\"}\u003c/ul\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  `;\n\n  card.querySelector(\".entry-head\").addEventListener(\"click\", () =\u003e {\n    card.querySelector(\".entry-body\").classList.toggle(\"open\");\n  });\n\n  return card;\n}\n\nfunction escapeHtml(str) {\n  const div = document.createElement(\"div\");\n  div.textContent = str == null ? \"\" : String(str);\n  return div.innerHTML;\n}\n\n/* =========================================================================\n   WebSocket chat\n   ========================================================================= */\nlet ws = null;\nlet wsReconnectTimer = null;\n\nfunction setWsStatus(connected) {\n  document.getElementById(\"ws-status-dot\").classList.toggle(\"connected\", connected);\n  document.getElementById(\"ws-status-text\").textContent = connected ? \"Connected\" : \"Disconnected\";\n  document.getElementById(\"chat-input\").disabled = !connected;\n  document.getElementById(\"btn-send-chat\").disabled = !connected;\n}\n\nfunction connectWebSocket() {\n  if (!session.accessToken) return;\n  const url = `${CONFIG.WEBSOCKET_API_URL}?token=${encodeURIComponent(session.accessToken)}`;\n  ws = new WebSocket(url);\n\n  ws.onopen = () =\u003e {\n    setWsStatus(true);\n    ws.send(JSON.stringify({ action: \"getChatHistory\" }));\n  };\n\n  ws.onclose = () =\u003e {\n    setWsStatus(false);\n    clearTimeout(wsReconnectTimer);\n    wsReconnectTimer = setTimeout(connectWebSocket, 4000);\n  };\n\n  ws.onerror = () =\u003e setWsStatus(false);\n\n  ws.onmessage = (event) =\u003e {\n    let data;\n    try {\n      data = JSON.parse(event.data);\n    } catch {\n      return;\n    }\n    if (data.type === \"history\") {\n      renderChatHistory(data.messages || []);\n    } else if (data.type === \"message\") {\n      appendChatMessage(data.message);\n    } else if (data.type === \"error\") {\n      console.warn(\"Chat error:\", data.error);\n    }\n  };\n}\n\nfunction renderChatHistory(messages) {\n  const feed = document.getElementById(\"chat-feed\");\n  feed.innerHTML = \"\";\n  if (messages.length === 0) {\n    feed.innerHTML = '\u003cdiv class=\"empty-state\"\u003eNo messages yet. Say hello 👋\u003c/div\u003e';\n    return;\n  }\n  messages.forEach((m) =\u003e appendChatMessage(m, false));\n  feed.scrollTop = feed.scrollHeight;\n}\n\nfunction appendChatMessage(msg, scroll = true) {\n  const feed = document.getElementById(\"chat-feed\");\n  const empty = feed.querySelector(\".empty-state\");\n  if (empty) empty.remove();\n\n  const isOwn = msg.UserHandle === session.email;\n  const time = new Date(msg.Timestamp).toLocaleTimeString([], { hour: \"2-digit\", minute: \"2-digit\" });\n\n  const el = document.createElement(\"div\");\n  el.className = \"chat-msg\" + (isOwn ? \" own\" : \"\");\n  el.innerHTML = `\n    \u003cdiv class=\"chat-msg-head\"\u003e\n      \u003cspan class=\"chat-handle\"\u003e${escapeHtml(msg.UserHandle)}\u003c/span\u003e\n      \u003cspan class=\"chat-time\"\u003e${time}\u003c/span\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"chat-text\"\u003e${escapeHtml(msg.Message)}\u003c/div\u003e\n  `;\n  feed.appendChild(el);\n  if (scroll) feed.scrollTop = feed.scrollHeight;\n}\n\nfunction sendChatMessage() {\n  const input = document.getElementById(\"chat-input\");\n  const text = input.value.trim();\n  if (!text || !ws || ws.readyState !== WebSocket.OPEN) return;\n  ws.send(JSON.stringify({ action: \"sendMessage\", message: text }));\n  input.value = \"\";\n}\n\ndocument.getElementById(\"btn-send-chat\").addEventListener(\"click\", sendChatMessage);\ndocument.getElementById(\"chat-input\").addEventListener(\"keydown\", (e) =\u003e {\n  if (e.key === \"Enter\") sendChatMessage();\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n",
